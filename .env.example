# ShaadiSaathi Environment Variables Configuration Template
# NOTE: Never commit production credentials, secret tokens, or API keys to Git.

# Public Application Variables (Vite client-side)
VITE_APP_NAME="ShaadiSaathi"
VITE_APP_ENV="development"
VITE_DEFAULT_LANGUAGE="en"

# Future Phase 2 Backend Configuration (Zero-Cost Free Tier)
# Local development backend API endpoint (e.g. Cloudflare Worker or local mock)
VITE_API_BASE_URL="http://localhost:8787/api"

# PWA Service Worker Enablement
VITE_ENABLE_SW="true"
