# =====================================================================
# ShaadiSaathi (शादीसाथी) Environment Configuration Template
# NOTE: Never commit sensitive credentials, passwords, or production secrets to Git.
# =====================================================================

# --- Server Runtime ---
NODE_ENV=production
PORT=3001

# --- Storage & Database Configuration ---
# Absolute or relative path to persistent SQLite database file
DATABASE_PATH=data/shaadisaathi.db

# Absolute or relative directory for uploaded receipts & documents
UPLOADS_DIR=data/uploads/documents

# --- Security & Network Isolation ---
# Comma-separated list of allowed origins for production CORS & CSRF enforcement
# (Leave blank or omit to allow self-hosted same-origin requests)
# ALLOWED_ORIGINS=https://wedding.myfamily.com,https://shaadisaathi.example.com

# --- Optional Cloud AI Enhancement ---
# Optional Google Gemini API key for Gemini 2.5 Flash enhanced OCR.
# Core application runs 100% locally with Tesseract OCR if this is omitted.
# GEMINI_API_KEY=

# --- Frontend Client Build Variables ---
VITE_APP_NAME="ShaadiSaathi"
VITE_ENABLE_SW="true"
VITE_DEFAULT_LANGUAGE="en"
